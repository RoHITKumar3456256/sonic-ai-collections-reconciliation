# Application Environment
APP_ENV=development
APP_SECRET_KEY=replace_with_random_secret_at_least_32_chars_long
API_PORT=8000
FRONTEND_URL=http://localhost:5173

# Database (PyMongo with standalone fallback to mongomock if MongoDB is offline)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=sonic_ai

# LLM Configuration (Gemini API)
# Get a key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# SMTP Outbound Email (Reminders)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_organization_email@gmail.com
SMTP_PASSWORD=your_gmail_app_password
SMTP_FROM_NAME="AcmeCorp Accounts Receivables"

# IMAP Inbound Email (Reply Ingestion)
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USERNAME=your_organization_email@gmail.com
IMAP_PASSWORD=your_gmail_app_password

# Testing inbox
CUSTOMER_TEST_EMAIL=your_customer_test_email@example.com

# Reference Date for Overdue Calculations (Default: today, or specify YYYY-MM-DD for deterministic testing)
REFERENCE_DATE=2026-11-01

